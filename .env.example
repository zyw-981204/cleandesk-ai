# mock works with no API key. Set qwen and a DashScope key to use the live model.
LLM_PROVIDER=mock

# Alibaba Cloud Model Studio, international (Singapore) region.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_CHAT_MODEL=qwen-plus
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3

# Leave both blank to use the in-memory demo store. Set both to use Supabase.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cookie gate for the demo. This is not a real account system.
DEMO_PASSWORD=harbor-demo
